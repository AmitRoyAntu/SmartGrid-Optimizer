# =============================================================================
# GridWise LLM — Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the placeholder values below.
#   3. NEVER commit the .env file (it is git-ignored).
#
# Get a free Groq API key at: https://console.groq.com/keys
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider — Groq (locked decision)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Latency & Reliability
# -----------------------------------------------------------------------------
# Hard timeout for a single LLM call. Must keep p95 <= 5s per rubric.
LLM_TIMEOUT_SEC=4.0

# -----------------------------------------------------------------------------
# Observability & Environment
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Allowed: development | staging | production
# In production, app will refuse to boot with a placeholder GROQ_API_KEY.
APP_ENV=production
# Environment Variables Template
HOST=0.0.0.0
PORT=8000

# Team API keys and settings will be added here as needed
