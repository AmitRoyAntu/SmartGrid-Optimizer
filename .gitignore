.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.env.virtualenv/
.envrc

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
*.env
!.env.example
secrets/
credentials.json
*.pem
*.key
*.cert
*.pfx

# Testing, Linting & Type Checking caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
**/__pycache__-pytest*
.mypy_cache/
.ruff_cache/
cover/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

